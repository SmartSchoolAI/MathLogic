    },
    {
      "id": "section-3",
      "type": "zhao-shuang-proof",
      "title": "3. 证明二：赵爽弦图抵消证明",
      "subtitle": "2ab + (b-a)² = c² ⇒ 2ab与-2ab抵消",
      "formula": "2ab + (b-a)^2 = c^2 \\Longrightarrow a^2 + b^2 = c^2",
